generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Enums 

enum UserRole {
  MEMBER
  TEAM_LEADER
  VP
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum EpStatus {
  LEAD
  CONTACTED
  INTERESTED
  APPROVED
  REALIZED
  COMPLETED
  FINISHED
}

enum Product {
  GV
  GTA
  GTE
}

enum TrackingPhase {
  WAITING_FOR_ANSWER
  EP_NOT_RESPONDING
  EXPLAINING_AIESEC
  LOOKING_FOR_OPPORTUNITIES
  HAVING_INTERVIEW
  WILL_SIGN_CONTRACT
  CONTRACT_SIGNED
  WAITING_FOR_CV
  NOT_INTERESTED_ANYMORE
}

enum Duration {
  LONG
  MID
  SHORT
}

enum Availability {
  THIS_SUMMER
  THIS_WINTER
  NEXT_SUMMER
  NEXT_WINTER
}

// Models 

model Department {
  id      String  @id @default(uuid())
  name    String  @unique
  product Product
  users   User[]
  eps     Ep[]
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  /// Null for OAuth-only accounts (no password set)
  passwordHash String?
  fullName     String
  role         UserRole     @default(MEMBER)
  provider     AuthProvider @default(LOCAL)
  /// Null for LOCAL accounts
  googleId     String?      @unique
  departmentId String?
  department   Department?  @relation(fields: [departmentId], references: [id])
  /// The Team Leader this member is assigned to (null = unassigned)
  teamLeaderId String?
  teamLeader   User?        @relation("MemberTL", fields: [teamLeaderId], references: [id])
  managedMembers User[]     @relation("MemberTL")
  isDispatcher Boolean      @default(false)
  isDisabled   Boolean      @default(false)
  avatarUrl    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  refreshTokens      RefreshToken[]
  passwordResetOtps  PasswordResetOtp[]
  ownedEps           Ep[]               @relation("EpOwner")
  comments           Comment[]
  triggeredTransitions TransitionHistory[]
  statusChanges      StatusHistory[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// bcrypt hash of the raw JWT string, the raw value is never stored
  tokenHash String
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetOtp {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// bcrypt hash of the 6-digit OTP, the raw value is never stored
  otpHash   String
  isUsed    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Ep {
  id            String         @id
  fullName      String
  email         String?
  phone         String?
  university    String?
  fieldOfStudy  String?
  yearOfStudy   Int?
  source        String?
  cvLink        String?
  product       Product
  departmentId  String
  department    Department     @relation(fields: [departmentId], references: [id])
  ownerId       String?
  owner         User?          @relation("EpOwner", fields: [ownerId], references: [id])
  statusOnExpa  EpStatus       @default(LEAD)
  trackingPhase TrackingPhase?
  contacted     Boolean        @default(false)
  interested    Boolean        @default(false)
  assignedAt    DateTime?
  contactedAt   DateTime?
  notes         String?
  duration      Duration?
  availability  Availability?
  createdAtExpa DateTime
  syncedAt      DateTime       @default(now()) @updatedAt
  updatedAt     DateTime       @updatedAt

  approvedDetail     ApprovedDetail?
  statusHistory      StatusHistory[]
  transitionHistory  TransitionHistory[]
  comments           Comment[]

  @@index([departmentId])
  @@index([statusOnExpa])
  @@index([ownerId])
}

model ApprovedDetail {
  id               String    @id @default(uuid())
  epId             String    @unique
  ep               Ep        @relation(fields: [epId], references: [id], onDelete: Cascade)
  // EXPA application ID, kept for deduplication on re-sync
  expaAppId        String    @unique
  opportunityTitle String?
  hostingMC        String?
  hostingLC        String?
  projectFees      Float?
  approvalDate     DateTime?
  realizedDate     DateTime?
  completedDate    DateTime?
  finishedDate     DateTime?
  contractLink     String?
  auditFolder      String?
  syncedAt         DateTime  @default(now()) @updatedAt
}

model StatusHistory {
  id          String   @id @default(uuid())
  epId        String
  ep          Ep       @relation(fields: [epId], references: [id], onDelete: Cascade)
  changedById String?
  changedBy   User?    @relation(fields: [changedById], references: [id])
  fromStatus  EpStatus
  toStatus    EpStatus
  changedAt   DateTime @default(now())

  @@index([epId])
  @@index([changedAt])
}

model TransitionHistory {
  id              String   @id @default(uuid())
  epId            String
  ep              Ep       @relation(fields: [epId], references: [id], onDelete: Cascade)
  triggeredById   String?
  triggeredBy     User?    @relation(fields: [triggeredById], references: [id])
  fromProduct     Product?
  toProduct       Product?
  fromDepartment  String?
  toDepartment    String?
  note            String?
  createdAt       DateTime @default(now())

  @@index([epId])
}

model Comment {
  id        String   @id @default(uuid())
  epId      String
  ep        Ep       @relation(fields: [epId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  fieldName String?
  content   String
  createdAt DateTime @default(now())

  @@index([epId])
}